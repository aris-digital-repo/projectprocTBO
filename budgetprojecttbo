:root {
  --font-display: "Bricolage Grotesque", "Plus Jakarta Sans", system-ui, sans-serif;
  --font-body: "Plus Jakarta Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;

  --r-lg: 20px; --r-md: 12px; --r-sm: 8px;
  --gutter: clamp(16px, 3vw, 32px);
  --maxw: 1440px;
  color-scheme: dark;
}

/* ───── Tema gelap (default) ───── */
:root, :root[data-theme="dark"] {
  --bg: #06110d;
  --bg-2: #0a1a14;
  --panel: rgba(255, 255, 255, 0.04);
  --panel-solid: #0d1f18;
  --panel-hi: rgba(255, 255, 255, 0.075);
  --line: rgba(255, 255, 255, 0.09);
  --line-strong: rgba(255, 255, 255, 0.18);
  --ink: #eef6f1;
  --ink-2: #b4c6bb;
  --ink-3: #7f9488;

  --gold: #f2c14e;
  --gold-ink: #1a1405;
  --gold-soft: rgba(242, 193, 78, 0.14);

  --ok: #34d99c;
  --warn: #ffb547;
  --danger: #ff6b83;
  --info: #62a8ff;
  --violet: #b9a2ff;
  --muted: #8da296;

  /* warna chart tervalidasi (validate_palette.js, mode dark) */
  --c1: #4c8dff; --c2: #0fa36b; --c3: #bd7b14;
  --bar-gold: #e0ad3b;

  --shadow: 0 1px 0 rgba(255,255,255,.05) inset, 0 18px 40px -24px rgba(0,0,0,.7);
  --glow-a: rgba(15, 163, 107, 0.20);
  --glow-b: rgba(242, 193, 78, 0.10);
  --hero-grad: linear-gradient(140deg, #0f3a2a 0%, #0a2018 55%, #07120d 100%);
  --topbar-bg: rgba(6, 17, 13, 0.78);
}

/* ───── Tema terang ───── */
:root[data-theme="light"] {
  color-scheme: light;
  --bg: #eef4f0;
  --bg-2: #e6efe9;
  --panel: #ffffff;
  --panel-solid: #ffffff;
  --panel-hi: #f3f8f5;
  --line: rgba(10, 45, 32, 0.12);
  --line-strong: rgba(10, 45, 32, 0.24);
  --ink: #0b2118;
  --ink-2: #3b574a;
  --ink-3: #62796d;

  --gold: #9a6a05;
  --gold-ink: #fff9e8;
  --gold-soft: rgba(154, 106, 5, 0.12);

  --ok: #0a7d52;
  --warn: #a35f00;
  --danger: #c4243f;
  --info: #1f5fd1;
  --violet: #6a49d6;
  --muted: #5f776a;

  --bar-gold: #c18a14;
  --shadow: 0 1px 2px rgba(10,45,32,.06), 0 14px 30px -22px rgba(10,45,32,.35);
  --glow-a: rgba(15, 163, 107, 0.12);
  --glow-b: rgba(242, 193, 78, 0.18);
  --hero-grad: linear-gradient(140deg, #0f3a2a 0%, #0b2a1f 60%, #082016 100%);
  --topbar-bg: rgba(238, 244, 240, 0.82);
}

/* ───── Reset & dasar ───── */
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-padding-top: 130px; }
body {
  margin: 0;
  font: 400 14.5px/1.55 var(--font-body);
  color: var(--ink);
  background:
    radial-gradient(900px 520px at 8% -8%, var(--glow-a), transparent 60%),
    radial-gradient(760px 480px at 100% 0%, var(--glow-b), transparent 60%),
    var(--bg);
  background-attachment: fixed;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  font-variant-numeric: tabular-nums;
}
h1, h2, h3, h4, p, dl, dd, ul { margin: 0; padding: 0; }
ul { list-style: none; }
button, input, select { font: inherit; color: inherit; }
button { cursor: pointer; }
a { color: inherit; text-decoration: none; }
[hidden] { display: none !important; }
.ic { flex: none; vertical-align: -0.18em; }
.muted { color: var(--ink-3); }
.mono { font-family: var(--font-mono); font-weight: 500; }

:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; border-radius: 6px; }
.skip { position: absolute; left: -999px; top: 8px; background: var(--gold); color: var(--gold-ink); padding: 8px 14px; border-radius: 8px; z-index: 100; font-weight: 700; }
.skip:focus { left: 8px; }

/* ───── Topbar ───── */
.topbar {
  position: sticky; top: 0; z-index: 30;
  background: var(--topbar-bg);
  backdrop-filter: blur(18px) saturate(1.3);
  -webkit-backdrop-filter: blur(18px) saturate(1.3);
  border-bottom: 1px solid var(--line);
}
.topbar__inner {
  max-width: var(--maxw); margin: 0 auto; padding: 12px var(--gutter);
  display: flex; align-items: center; gap: 20px;
}
.brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
.brand__mark { display: grid; place-items: center; filter: drop-shadow(0 4px 14px rgba(242,193,78,.25)); }
.brand__text { display: grid; line-height: 1.2; min-width: 0; }
.brand__text strong { font: 700 17px/1.2 var(--font-display); letter-spacing: -0.01em; white-space: nowrap; }
.brand__text small { color: var(--ink-3); font-size: 12px; white-space: nowrap; }

.topbar__status { margin-left: auto; display: flex; align-items: center; gap: 14px; min-width: 0; }
.live {
  display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px; border-radius: 999px;
  font-size: 12px; font-weight: 700; color: var(--ok);
  background: color-mix(in srgb, var(--ok) 13%, transparent); border: 1px solid color-mix(in srgb, var(--ok) 32%, transparent);
  white-space: nowrap;
}
.live__dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 0 currentColor; animation: pulse 2.2s infinite; }
.live[data-state="loading"] { color: var(--warn); }
.live[data-state="error"] { color: var(--danger); }
.live[data-state="error"] .live__dot, .live[data-state="loading"] .live__dot { animation: none; }
@keyframes pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, currentColor 55%, transparent); } 70%, 100% { box-shadow: 0 0 0 8px transparent; } }
.sync { color: var(--ink-3); font-size: 12px; white-space: nowrap; }

.topbar__actions { display: flex; align-items: center; gap: 8px; }

/* ───── Tombol ───── */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  height: 38px; padding: 0 14px; border-radius: 10px;
  background: var(--panel); border: 1px solid var(--line); color: var(--ink);
  font-size: 13px; font-weight: 600; transition: background .15s, border-color .15s, transform .15s;
}
.btn:hover { background: var(--panel-hi); border-color: var(--line-strong); }
.btn:active { transform: translateY(1px); }
.btn--icon { width: 38px; padding: 0; }
.btn--gold {
  background: linear-gradient(135deg, #f6d77a, #d9a22d); color: var(--gold-ink); border-color: transparent;
  box-shadow: 0 6px 22px -8px rgba(242,193,78,.55);
}
.btn--gold:hover { background: linear-gradient(135deg, #f9e090, #e2ac38); border-color: transparent; }
:root[data-theme="light"] .btn--gold { background: linear-gradient(135deg, #b98410, #8d6203); color: #fff; }
.btn.is-spinning .ic { animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ───── Tab ───── */
.tabs {
  position: relative; display: flex; gap: 2px; max-width: var(--maxw); margin: 0 auto; padding: 0 var(--gutter);
  overflow-x: auto; scrollbar-width: none;
}
.tabs::-webkit-scrollbar { display: none; }
.tabs button {
  position: relative; display: inline-flex; align-items: center; gap: 8px; flex: none;
  padding: 12px 14px 13px; background: none; border: 0; color: var(--ink-3);
  font-size: 13.5px; font-weight: 600; white-space: nowrap; transition: color .15s;
}
.tabs button:hover { color: var(--ink); }
.tabs button[aria-selected="true"] { color: var(--ink); }
.tabs__ink {
  position: absolute; left: 0; bottom: 0; height: 3px; width: 0; border-radius: 3px 3px 0 0;
  background: linear-gradient(90deg, var(--gold), var(--ok));
  transition: transform .35s cubic-bezier(.3,.8,.3,1), width .35s cubic-bezier(.3,.8,.3,1);
}
.tabs__count {
  min-width: 22px; padding: 1px 7px; border-radius: 999px; font-size: 11px; font-weight: 700; text-align: center;
  background: var(--panel-hi); color: var(--ink-2); border: 1px solid var(--line);
}
.tabs__count:empty { display: none; }
.tabs__count.is-alert { background: color-mix(in srgb, var(--danger) 18%, transparent); color: var(--danger); border-color: color-mix(in srgb, var(--danger) 40%, transparent); }

/* ───── Layout halaman ───── */
main { max-width: var(--maxw); margin: 0 auto; padding: 24px var(--gutter) 40px; }
.intro { margin-bottom: 22px; }
.intro h1 { font: 700 clamp(22px, 2.6vw, 30px)/1.15 var(--font-display); letter-spacing: -0.02em; }
.intro p { color: var(--ink-2); margin-top: 6px; max-width: 70ch; }
.view { display: flex; flex-direction: column; gap: 20px; }
.view[hidden] { display: none; }
.foot { max-width: var(--maxw); margin: 0 auto; padding: 8px var(--gutter) 40px; color: var(--ink-3); font-size: 12px; }

.panel {
  background: var(--panel); border: 1px solid var(--line); border-radius: var(--r-lg);
  padding: 20px; box-shadow: var(--shadow); min-width: 0;
}
.panel__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.panel__head--wrap { flex-wrap: wrap; }
.panel h2, .block h2, .block__head h2, .view > header h2 { font: 650 17px/1.3 var(--font-display); letter-spacing: -0.01em; }
.block__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.block__head p { margin-top: 2px; }
.block__tools { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.block { display: flex; flex-direction: column; gap: 14px; }
.chip { padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; color: var(--ink-2); background: var(--panel-hi); border: 1px solid var(--line); white-space: nowrap; }

/* ───── Hero ───── */
.hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 16px; }
.hero__total {
  position: relative; overflow: hidden; color: #eef6f1; border-color: rgba(242,193,78,.28);
  background: var(--hero-grad);
  display: flex; flex-direction: column; gap: 14px; padding: 24px;
}
.hero__total::before {
  content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .5;
  background:
    repeating-linear-gradient(115deg, rgba(242,193,78,.07) 0 1px, transparent 1px 22px),
    radial-gradient(420px 220px at 90% 0%, rgba(242,193,78,.22), transparent 70%);
}
.hero__total > * { position: relative; }
.hero__total .panel__head { margin: 0; }
.hero__total h2 { color: #cfe3d7; font-weight: 600; font-size: 15px; }
.hero__total .chip { background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.16); color: #dcebe2; }
.hero__value {
  font: 800 clamp(34px, 5.4vw, 62px)/1 var(--font-display); letter-spacing: -0.03em;
  background: linear-gradient(180deg, #fff0b8 0%, #f2c14e 55%, #cf9a2c 100%);
  -webkit-background-clip: text; background-clip: text; color: transparent;
  padding-bottom: 4px;
}
.split__bar { display: flex; gap: 3px; height: 10px; border-radius: 6px; overflow: hidden; background: rgba(255,255,255,.08); }
.split__bar i { display: block; height: 100%; transition: width .9s cubic-bezier(.2,.8,.2,1); }
.split__opex { background: #34d99c; width: 0; border-radius: 6px 0 0 6px; }
.split__capex { background: #62a8ff; width: 0; border-radius: 0 6px 6px 0; }
.split__legend { display: flex; gap: 28px; margin-top: 10px; flex-wrap: wrap; }
.split__legend dt { display: flex; align-items: center; gap: 8px; color: #b4c9bc; font-size: 12.5px; }
.split__legend dd { font: 650 18px/1.3 var(--font-display); color: #f3faf6; margin-top: 2px; }
.swatch { display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: var(--muted); flex: none; }
.swatch--opex { background: #34d99c; } .swatch--capex { background: #62a8ff; }
.swatch--danger { background: var(--danger); } .swatch--warn { background: var(--warn); } .swatch--ok { background: var(--ok); }
.swatch--muted { background: var(--muted); opacity: .6; }
.swatch--open { background: repeating-linear-gradient(135deg, var(--ink-3) 0 3px, transparent 3px 6px); border: 1px solid var(--ink-3); }
.swatch--c1 { background: var(--c1); } .swatch--c2 { background: var(--c2); } .swatch--c3 { background: var(--c3); }
.hero__next { margin-top: auto; color: #cfe3d7; font-size: 13.5px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,.12); }
.hero__next b { color: #fff; }
.hero__next .tone-danger { color: #ff9aab; } .hero__next .tone-warn { color: #ffcf7d; }

/* ───── KPI ───── */
.kpis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.kpis--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.kpi {
  --tone: var(--gold);
  position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 4px;
  text-align: left; padding: 18px; color: inherit; transition: border-color .15s, background .15s, transform .15s;
}
button.kpi:hover { background: var(--panel-hi); border-color: color-mix(in srgb, var(--tone) 55%, transparent); transform: translateY(-2px); }
.kpi--danger { --tone: var(--danger); } .kpi--info { --tone: var(--info); } .kpi--ok { --tone: var(--ok); } .kpi--warn { --tone: var(--warn); }
.kpi__icon {
  display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; margin-bottom: 8px;
  color: var(--tone); background: color-mix(in srgb, var(--tone) 14%, transparent); border: 1px solid color-mix(in srgb, var(--tone) 28%, transparent);
}
.kpi__label { color: var(--ink-2); font-size: 13px; font-weight: 600; }
.kpi__value { font: 750 clamp(28px, 3vw, 38px)/1.05 var(--font-display); letter-spacing: -0.02em; }
.kpi__value--money { font-size: clamp(22px, 2.2vw, 28px); }
.kpi--danger .kpi__value { color: var(--danger); }
.kpi__sub { color: var(--ink-3); font-size: 12.5px; }

/* ───── Runway (elemen utama) ───── */
.runway { padding: 22px 22px 18px; }
.runway__scroll { overflow-x: auto; margin: 0 -6px; padding: 0 6px 6px; }
.runway__grid { position: relative; min-width: 820px; --label: 232px; }
.rw-axis, .rw-row { display: grid; grid-template-columns: var(--label) 1fr; align-items: center; }
.rw-axis { height: 58px; color: var(--ink-3); font-size: 11.5px; }
.rw-axis__track, .rw-track { position: relative; height: 100%; }
.rw-tick { position: absolute; top: 0; bottom: 0; border-left: 1px solid var(--line); padding: 30px 0 0 6px; white-space: nowrap; pointer-events: none; line-height: 1.25; }
.rw-tick b { display: block; color: var(--ink-2); font-weight: 700; }
.rw-row { height: 44px; border-top: 1px solid var(--line); cursor: pointer; transition: background .15s; }
.rw-row:hover { background: var(--panel-hi); }
.rw-row:focus-visible { outline-offset: -2px; }
.rw-label { padding-right: 14px; min-width: 0; line-height: 1.25; }
.rw-label b { display: block; font-size: 13px; font-weight: 650; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rw-label span { display: block; font-size: 11.5px; color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rw-bar {
  --tone: var(--ok);
  position: absolute; top: 12px; height: 20px; border-radius: 6px; min-width: 6px;
  background: color-mix(in srgb, var(--tone) 78%, transparent);
  border: 1px solid color-mix(in srgb, var(--tone) 90%, #fff 10%);
  transform-origin: left center; animation: grow .9s cubic-bezier(.2,.8,.2,1) both; animation-delay: calc(var(--i, 0) * 55ms);
  display: flex; align-items: center; padding: 0 8px; font-size: 11px; font-weight: 700; color: #04130c; white-space: nowrap; overflow: hidden;
}
:root[data-theme="light"] .rw-bar { color: #fff; }
.rw-bar--danger { --tone: var(--danger); } .rw-bar--warn { --tone: var(--warn); } .rw-bar--ok { --tone: var(--ok); }
.rw-bar--muted { --tone: var(--muted); opacity: .75; }
.rw-bar--open {
  --tone: var(--ink-3); border-style: dashed; color: var(--ink-2);
  background: repeating-linear-gradient(135deg, color-mix(in srgb, var(--tone) 28%, transparent) 0 6px, transparent 6px 12px);
  -webkit-mask-image: linear-gradient(90deg, #000 55%, transparent); mask-image: linear-gradient(90deg, #000 55%, transparent);
}
@keyframes grow { from { transform: scaleX(0); opacity: 0; } to { transform: scaleX(1); opacity: 1; } }
.rw-inner { position: relative; }
.rw-overlay { position: absolute; left: var(--label); right: 0; top: 0; bottom: 0; pointer-events: none; }
.rw-gline { position: absolute; top: 58px; bottom: 0; border-left: 1px solid var(--line); opacity: .55; }
.rw-today { position: absolute; top: 0; bottom: 0; width: 0; border-left: 2px solid var(--gold); z-index: 3; pointer-events: none; }
.rw-today span {
  position: absolute; top: 2px; left: 50%; transform: translateX(-50%); padding: 2px 9px; border-radius: 999px;
  background: var(--gold); color: var(--gold-ink); font-size: 11px; font-weight: 800; white-space: nowrap;
  box-shadow: 0 6px 18px -6px rgba(242,193,78,.7);
}
.runway__note { font-size: 12.5px; margin-top: 10px; }

/* ───── Legenda ───── */
.legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 12.5px; color: var(--ink-2); }
.legend li { display: inline-flex; align-items: center; gap: 7px; }

/* ───── Chart ───── */
.charts { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 16px; }
.chartbox { position: relative; height: 290px; }
.chartbox--tall { height: 500px; }
.chartbox--donut { height: 230px; flex: 1 1 230px; max-width: 280px; }
.donut { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
.donut__center { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; pointer-events: none; }
.donut__center b { font: 800 34px/1 var(--font-display); }
.donut__center span { color: var(--ink-3); font-size: 12px; }
.donut__legend { display: grid; gap: 10px; flex: 1 1 160px; }
.donut__legend li { display: grid; grid-template-columns: 12px 1fr auto; align-items: center; gap: 10px; font-size: 13px; }
.donut__legend i { width: 12px; height: 12px; border-radius: 4px; }
.donut__legend b { font: 700 16px var(--font-display); }
.datatable { margin-top: 10px; font-size: 12.5px; }
.datatable summary { cursor: pointer; color: var(--ink-3); width: fit-content; padding: 4px 0; }
.datatable summary:hover { color: var(--ink); }
.datatable table { width: 100%; border-collapse: collapse; margin-top: 6px; }
.datatable th, .datatable td { text-align: left; padding: 6px 8px; border-top: 1px solid var(--line); }
.datatable td:last-child, .datatable th:last-child { text-align: right; }

/* ───── Toolbar & kontrol ───── */
.toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; }
.search {
  display: flex; align-items: center; gap: 10px; height: 40px; padding: 0 12px; flex: 1 1 280px; max-width: 460px;
  background: var(--panel); border: 1px solid var(--line); border-radius: 10px; color: var(--ink-3);
}
